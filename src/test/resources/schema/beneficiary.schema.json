{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Saxlanmış alıcı (POST /beneficiaries 201 cavabı)",
  "type": "object",
  "required": ["id", "fullName", "iban", "ibanMasked", "currency", "createdAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^ben_.{8}$" },
    "fullName": { "type": "string", "minLength": 1 },
    "iban": { "type": "string", "pattern": "^AZ[0-9]{2}[A-Z]{4}[0-9]{20}$" },
    "ibanMasked": { "type": "string" },
    "currency": { "type": "string", "enum": ["AZN", "USD", "EUR"] },
    "nickname": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
