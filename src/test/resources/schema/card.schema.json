{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Virtual kart (POST /cards 201 cavabı)",
  "type": "object",
  "required": ["id", "accountId", "label", "maskedPan", "expiry", "currency", "status", "availableBalance", "limits"],
  "properties": {
    "id": { "type": "string", "pattern": "^vcd_.{8}$" },
    "accountId": { "type": "string" },
    "label": { "type": "string" },
    "maskedPan": { "type": "string" },
    "expiry": { "type": "string", "pattern": "^[0-9]{2}/[0-9]{2}$" },
    "currency": { "type": "string" },
    "status": { "type": "string", "minLength": 1 },
    "availableBalance": { "type": "number" },
    "limits": {
      "type": "object",
      "required": ["dailyOnline", "perTransaction"],
      "properties": {
        "dailyOnline": { "type": "number" },
        "perTransaction": { "type": "number" }
      }
    }
  }
}
