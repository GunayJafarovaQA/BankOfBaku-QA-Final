{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alıcılar siyahısı (GET /beneficiaries 200 cavabı)",
  "type": "object",
  "required": ["total", "items"],
  "properties": {
    "total": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fullName", "iban", "currency", "createdAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^ben_.{8}$" },
          "fullName": { "type": "string" },
          "iban": { "type": "string" },
          "currency": { "type": "string", "enum": ["AZN", "USD", "EUR"] },
          "nickname": { "type": ["string", "null"] },
          "createdAt": { "type": "string" }
        }
      }
    }
  }
}
